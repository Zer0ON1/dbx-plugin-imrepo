            "field": "auth_type",
            "one_of": [
              "aliyun-aksk",
              "tencent-aksk"
            ]
          }
        }
      ],
      "workbench": "com.leavingrain.imrepo.main",
      "capabilities": [
        "test",
        "connect",
        "disconnect"
      ],
      "actions": [
        {
          "id": "refresh",
          "label": "Refresh metadata",
          "variant": "outline",
          "when": "edit",
          "requires_valid_form": true,
          "timeout_ms": 30000
        }
      ]
    },
    {
      "type": "workbench",
      "id": "com.leavingrain.imrepo.main",
      "label": "IMREPO",
      "icon": "assets/plugin.svg"
    },
    {
      "type": "mcp",
      "id": "com.leavingrain.imrepo.ai",
      "description": "Ask the registry: list projects, repositories, tags and image details, read vulnerability reports, and (with confirmation) create projects, change visibility, rename or delete tags.",
      "ai_tools": true,
      "external_tools": false
    }
  ],
