              "tencent-aksk"
            ]
          }
        },
        {
          "key": "instance_id",
          "label": "Instance ID",
          "type": "text",
          "binding": "config",
          "placeholder": "cri-xxxxxx (Aliyun) / tcr-xxxxxx (Tencent)",
