{
  "$schema": "https://raw.githubusercontent.com/t8y2/dbx/main/plugins/manifest.schema.json",
  "manifest_version": 1,
  "id": "com.leavingrain.imrepo",
  "name": "IMREPO",
  "version": "1.0.1",
  "publisher": "leavingrain",
  "description": "IMREPO - Image Registry Studio: browse, manage and inspect OCI / Harbor container registries from a single workbench.",
  "icon": "assets/plugin.svg",
  "source": "https://github.com/Zer0ON1/dbx-plugin-imrepo",
  "homepage": "https://github.com/Zer0ON1/dbx-plugin-imrepo",
  "engines": {
    "dbx": ">=0.6.0",
    "host_api": "1"
  },
  "permissions": [],
  "entrypoints": {
    "ui": {
      "root": "ui",
      "entry": "ui/index.html"
    },
    "backend": {
      "executable": "bin/imrepo-sidecar"
    }
  },
  "contributions": [
    {
      "type": "connection-provider",
      "id": "com.leavingrain.imrepo.connection",
      "label": "Container Registry",
      "icon": "assets/connection.svg",
      "database_type": "imrepo-registry",
      "description": "Connect to an OCI / Harbor container registry (Harbor, Docker Registry v2, Docker Hub, GHCR, Aliyun ACR, Tencent TCR, AWS ECR, Azure ACR, Nexus, Artifactory, Quay).",
      "fields": [
        {
          "key": "display_name",
          "label": "Name",
          "type": "text",
          "binding": "name",
          "required": true,
          "default": "IMREPO",
          "placeholder": "e.g. Prod Harbor"
        },
        {
          "key": "registry_type",
          "label": "Registry type",
          "type": "select",
          "binding": "config",
          "required": true,
          "default": "harbor",
          "options": [
            {
              "label": "Harbor",
              "value": "harbor"
            },
            {
              "label": "Docker Registry v2",
              "value": "docker-v2"
            },
            {
              "label": "Docker Hub",
              "value": "dockerhub"
            },
            {
              "label": "GitHub GHCR",
              "value": "ghcr"
            },
            {
              "label": "Aliyun ACR",
              "value": "aliyun-acr"
            },
            {
              "label": "Tencent TCR",
              "value": "tencent-tcr"
            },
            {
              "label": "AWS ECR",
              "value": "aws-ecr"
            },
            {
              "label": "Azure ACR",
              "value": "azure-acr"
            },
            {
              "label": "Sonatype Nexus 3",
              "value": "nexus"
            },
            {
              "label": "JFrog Artifactory",
              "value": "artifactory"
            },
            {
              "label": "Project Quay",
              "value": "quay"
            }
          ]
        },
        {
          "key": "endpoint",
          "label": "Endpoint",
          "type": "text",
          "binding": "host",
          "required": true,
          "placeholder": "registry.example.com"
        },
        {
          "key": "scheme",
          "label": "Protocol",
          "type": "select",
          "binding": "config",
          "required": true,
          "default": "https",
          "options": [
            {
              "label": "HTTPS",
              "value": "https"
            },
            {
              "label": "HTTP",
              "value": "http"
            }
          ]
        },
        {
          "key": "port",
          "label": "Port",
          "type": "number",
          "binding": "port",
          "default": 443
        },
        {
          "key": "insecure",
          "label": "Allow insecure HTTP / self-signed TLS",
          "type": "boolean",
          "binding": "config",
          "default": false
        },
        {
          "key": "auth_type",
          "label": "Authentication",
          "type": "select",
          "binding": "config",
          "required": true,
          "default": "basic",
          "options": [
            {
              "label": "Password / Basic Auth",
              "value": "basic"
            },
            {
              "label": "No Authentication",
              "value": "noauth"
            },
            {
              "label": "Harbor Robot Account",
              "value": "robot"
            },
            {
              "label": "Bearer / Personal Token",
              "value": "token"
            },
            {
              "label": "AWS ECR (AK/SK)",
              "value": "aws-ecr"
            },
            {
              "label": "Aliyun ACR (AK/SK)",
              "value": "aliyun-aksk"
            },
            {
              "label": "Tencent TCR (AK/SK)",
              "value": "tencent-aksk"
            }
          ]
        },
        {
          "key": "username",
          "label": "Username",
          "type": "text",
          "binding": "username",
          "placeholder": "admin or robot$name",
          "visible_when": {
            "field": "auth_type",
            "one_of": [
              "basic",
              "robot"
            ]
          }
        },
        {
          "key": "password",
          "label": "Password / CLI Secret",
          "type": "password",
          "binding": "secret",
          "visible_when": {
            "field": "auth_type",
            "one_of": [
              "basic",
              "robot"
            ]
          }
        },
        {
          "key": "token",
          "label": "Access token (PAT)",
          "type": "password",
          "binding": "secret",
          "visible_when": {
            "field": "auth_type",
            "one_of": [
              "token"
            ]
          }
        },
        {
          "key": "access_key_id",
          "label": "Access Key ID / SecretId",
          "type": "text",
          "binding": "config",
          "visible_when": {
            "field": "auth_type",
            "one_of": [
              "aws-ecr",
              "aliyun-aksk"
            ]
          }
        },
        {
          "key": "secret_access_key",
          "label": "Secret Access Key / SecretKey",
          "type": "password",
          "binding": "secret",
          "visible_when": {
            "field": "auth_type",
            "one_of": [
              "aws-ecr",
              "aliyun-aksk"
            ]
          }
        },
        {
          "key": "session_token",
          "label": "Session Token (temporary credentials)",
          "type": "password",
          "binding": "secret",
          "visible_when": {
            "field": "auth_type",
            "one_of": [
              "aws-ecr"
            ]
          }
        },
        {
          "key": "aws_profile",
          "label": "AWS profile (optional)",
          "type": "text",
          "binding": "config",
          "placeholder": "default",
          "visible_when": {
            "field": "auth_type",
            "one_of": [
              "aws-ecr"
            ]
          }
        },
        {
          "key": "secret_id",
          "label": "SecretId",
          "type": "text",
          "binding": "config",
          "visible_when": {
            "field": "auth_type",
            "one_of": [
              "tencent-aksk"
            ]
          }
        },
        {
          "key": "secret_key",
          "label": "SecretKey",
          "type": "password",
          "binding": "secret",
          "visible_when": {
            "field": "auth_type",
            "one_of": [
              "tencent-aksk"
            ]
          }
        },
        {
          "key": "region",
          "label": "Region",
          "type": "select",
          "binding": "config",
          "default": "",
          "options": [
            {
              "label": "Select a region",
              "value": ""
            },
            {
              "label": "AWS · us-east-1",
              "value": "us-east-1"
            },
            {
              "label": "AWS · us-east-2",
              "value": "us-east-2"
            },
            {
              "label": "AWS · us-west-1",
              "value": "us-west-1"
